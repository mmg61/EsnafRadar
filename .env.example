# --- Arka Uç (Backend) Yapılandırması ---
# Boş bırakılırsa ilk açılışta 64 karakterlik kriptografik anahtar otomatik üretilir
JWT_SECRET_KEY=

# Veritabanı Bağlantısı (Varsayılan: SQLite)
DATABASE_URL=sqlite:///./esnafradar.db

# CORS İzin Verilen Kökenler (Virgülle ayrılmış)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudflare Turnstile Bot Koruması
CLOUDFLARE_TURNSTILE_SECRET_KEY=
ALLOW_DEV_TURNSTILE=true

# Opsiyonel Sunucu Geneli Gemini API Anahtarı (Kullanıcılar kendi anahtarlarını da tanımlayabilir)
GEMINI_API_KEY=

# Şifre Sıfırlama E-postası (SMTP) Ayarları
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EsnafRadar Güvenlik

# Yalnızca yerel masaüstü başlatıcı (baslat.bat) için sekme kapanınca otomatik kapatma (SaaS ortamında 0 olmalıdır)
ENABLE_LOCAL_AUTO_SHUTDOWN=0

# --- Ön Yüz (Frontend - Vite) Yapılandırması ---
VITE_API_URL=http://localhost:8000/api
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
