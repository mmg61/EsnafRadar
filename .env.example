# --- Backend Configuration ---
# Leave empty to auto-generate a 64-char cryptographic key on first startup
JWT_SECRET_KEY=

# Database Connection URL (SQLite default; PostgreSQL supported via postgresql://...)
DATABASE_URL=sqlite:///./esnafradar.db

# Comma-separated allowed CORS origins
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudflare Turnstile Bot Protection
# Keep ALLOW_DEV_TURNSTILE=false in production; set true only in local development
CLOUDFLARE_TURNSTILE_SECRET_KEY=
ALLOW_DEV_TURNSTILE=false

# Optional server-wide Gemini API Key (users can also store encrypted per-user keys)
GEMINI_API_KEY=

# Password Reset Email (SMTP) Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EsnafRadar Security

# Local desktop auto-shutdown on tab close (must remain 0 in multi-user SaaS/Docker)
ENABLE_LOCAL_AUTO_SHUTDOWN=0

# --- Frontend (Vite) Configuration ---
VITE_API_URL=http://localhost:8000/api
VITE_TURNSTILE_SITE_KEY=
